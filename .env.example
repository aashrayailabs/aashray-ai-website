WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_NOTIFICATION_RECIPIENT=918096712222
ENABLE_LIVE_WHATSAPP=false

# =========================================================================
# CI/CD Deployment Metadata
# =========================================================================
NEXT_PUBLIC_BUILD_SHA=dev
