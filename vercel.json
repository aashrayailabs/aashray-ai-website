{
  "version": 2,
  "env": {
    "NEXT_PUBLIC_BUILD_SHA": "@vercel/git-commit-sha",
    "NEXT_PUBLIC_BUILD_TIME": "@vercel/build-date",
    "NEXT_PUBLIC_BRANCH": "@vercel/git-branch",
    "NEXT_PUBLIC_DEPLOY_URL": "@vercel/url",
    "NEXT_PUBLIC_ENV": "@vercel/env"
  },
  "builds": [
    {
      "src": "aashray-ai-website/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "aashray-ai-website/$1" }
  ]
}
